# Server-only Firebase Admin configuration for Firestore on Vercel.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----\n"

# Server-only write protection. Do not add the VITE_ prefix.
WRITE_ACCESS_CODE=change-this-private-code
WRITE_ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
