# Browser-visible read-only Supabase configuration.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-only Vercel API configuration. Never prefix these with VITE_ or commit real values.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
WRITE_ACCESS_CODE=change-this-private-code
WRITE_ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
